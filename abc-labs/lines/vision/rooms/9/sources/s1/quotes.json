.com/amplify_video/2105192144394964992/vid/avc1/1280x720/5B2RQI5MYYDDopc7.mp4?tag=29","bitrate":2176000,"container":"mp4","codec":"h264"},{"url":"https://video.twimg.com/amplify_video/2105192144394964992/vid/avc1/1920x1080/HWEvh7Y98nl-tdQB.mp4?tag=29","bitrate":10368000,"container":"mp4","codec":"h264"}],"publisher":null}]},"source":"Twitter Web App","provider":"twitter","reposted_by":null},"source":"Twitter for Android","provider":"twitter","reposted_by":null},{"type":"status","url":"https://x.com/cerspense/status/2105219969340567974","id":"2105219969340567974","text":"Very excited to see some progress on temporally stable depth estimation. Can't wait to make it real time","raw_text":{"text":"Very excited to see some progress on temporally stable depth estimation. Can't wait to make it real time","display_text_range":[0,104],"facets":[]},"author":{"screen_name":"cerspense","url":"https://x.com/cerspense","id":"1560347559612231680","followers":6577,"following":533,"likes":4185,"media_count":85,"statuses":387,"name":"Spencer Sterling","description":"Building Sentinel, a real-time node graph built for agents.\nFounder, Out Of Distribution Labs","raw_description":{"text":"Building Sentinel, a real-time node graph built for agents.\nFounder, Out Of Distribution Labs","facets":[]},"location":"Oakland, CA","banner_url":"","avatar_url":"https://pbs.twimg.com/profile_images/1648547266406547457/XUzxiDLa_200x200.jpg","joined":"Thu Aug 18 19:27:16 +0000 2022","protected":false,"website":{"url":"http://ood-labs.com/sentinel","display_url":"ood-labs.com/sentinel"},"verification":{"verified":true,"verified_at":null,"type":"individual"},"type":"profile"},"replies":0,"reposts":1,"likes":16,"bookmarks":10,"quotes":0,"embed_card":"player","created_at":"Wed Sep 30 08:55:28 +0000 2026","created_timestamp":1790758528,"views":1619,"is_note_tweet":false,"community_note":null,"lang":"en","replying_to":null,"media":{},"quote":{"type":"status","url":"https://x.com/breakdown_art/status/2105192577850806751","id":"2105192577850806751","text":"I am happy to share the results of my first serious attempt at training a model based on the insane Marigold V2 by @AntonObukhov1 and his team! \n\nAI generated depth of field has been historically unusable, lacking detail and temporal coherence. \nMarigoldV2 solved the detail part and I set out to solve the coherence. \n\nThrough a series of targeted training passes focusing on large scale morphing and flicker first, I then moved to boundary and edge detection before finally squeezing back in the detail using Marigold V2s Sink Loss technique\n\nThe end result speaks for itself and while still not perfect, I have learned tons and have set out to expand my personal library of high quality CGI, photoreal scenes so I can do a much larger training run in future. \n\nTraining was completed over 400 H200 Hours.","raw_text":{"text":"I am happy to share the results of my first serious attempt at training a model based on the insane Marigold V2 by @AntonObukhov1 and his team! \n\nAI generated depth of field has been historically unusable, lacking detail and temporal coherence. \nMarigoldV2 solved the detail part and I set out to solve the coherence. \n\nThrough a series of targeted training passes focusing on large scale morphing and flicker first, I then moved to boundary and edge detection before finally squeezing back in the detail using Marigold V2s Sink Loss technique\n\nThe end result speaks for itself and while still not perfect, I have learned tons and have set out to expand my personal library of high quality CGI, photoreal scenes so I can do a much larger training run in future. \n\nTraining was completed over 400 H200 Hours.","display_text_range":[0,807],"facets":[{"type":"mention","indices":[115,129],"original":"AntonObukhov1","id":"1257961662331707392"},{"type":"media","indices":[280,303],"id":"2105191464934461440","display":"pic.x.com/kex2XfgqnI","original":"https://t.co/kex2XfgqnI","replacement":"https://x.com/