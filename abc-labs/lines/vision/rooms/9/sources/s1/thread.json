g=29","thumbnail_url":"https://pbs.twimg.com/amplify_video_thumb/2105192144394964992/img/hEgQiEF6b0hrOin7.jpg","duration":10,"width":1920,"height":1080,"format":"video/mp4","type":"video","formats":[{"url":"https://video.twimg.com/amplify_video/2105192144394964992/pl/mopFhcvjqriGVc9l.m3u8?tag=29","container":"m3u8"},{"url":"https://video.twimg.com/amplify_video/2105192144394964992/vid/avc1/480x270/l6ZaDk-Z5fbavLJh.mp4?tag=29","bitrate":256000,"container":"mp4","codec":"h264"},{"url":"https://video.twimg.com/amplify_video/2105192144394964992/vid/avc1/640x360/RVAFdPoGJPS7l-_j.mp4?tag=29","bitrate":832000,"container":"mp4","codec":"h264"},{"url":"https://video.twimg.com/amplify_video/2105192144394964992/vid/avc1/1280x720/5B2RQI5MYYDDopc7.mp4?tag=29","bitrate":2176000,"container":"mp4","codec":"h264"},{"url":"https://video.twimg.com/amplify_video/2105192144394964992/vid/avc1/1920x1080/HWEvh7Y98nl-tdQB.mp4?tag=29","bitrate":10368000,"container":"mp4","codec":"h264"}],"publisher":null}]},"provider":"twitter","reposted_by":null},"thread":[{"type":"status","url":"https://x.com/breakdown_art/status/2105192577850806751","id":"2105192577850806751","text":"I am happy to share the results of my first serious attempt at training a model based on the insane Marigold V2 by @AntonObukhov1 and his team! \n\nAI generated depth of field has been historically unusable, lacking detail and temporal coherence. \nMarigoldV2 solved the detail part and I set out to solve the coherence. \n\nThrough a series of targeted training passes focusing on large scale morphing and flicker first, I then moved to boundary and edge detection before finally squeezing back in the detail using Marigold V2s Sink Loss technique\n\nThe end result speaks for itself and while still not perfect, I have learned tons and have set out to expand my personal library of high quality CGI, photoreal scenes so I can do a much larger training run in future. \n\nTraining was completed over 400 H200 Hours.","raw_text":{"text":"I am happy to share the results of my first serious attempt at training a model based on the insane Marigold V2 by @AntonObukhov1 and his team! \n\nAI generated depth of field has been historically unusable, lacking detail and temporal coherence. \nMarigoldV2 solved the detail part and I set out to solve the coherence. \n\nThrough a series of targeted training passes focusing on large scale morphing and flicker first, I then moved to boundary and edge detection before finally squeezing back in the detail using Marigold V2s Sink Loss technique\n\nThe end result speaks for itself and while still not perfect, I have learned tons and have set out to expand my personal library of high quality CGI, photoreal scenes so I can do a much larger training run in future. \n\nTraining was completed over 400 H200 Hours.","display_text_range":[0,807],"facets":[{"type":"mention","indices":[115,129],"original":"AntonObukhov1","id":"1257961662331707392"},{"type":"media","indices":[280,303],"id":"2105191464934461440","display":"pic.x.com/kex2XfgqnI","original":"https://t.co/kex2XfgqnI","replacement":"https://x.com/breakdown_art/status/2105192577850806751/video/1"},{"type":"media","indices":[280,303],"id":"2105191827104321536","display":"pic.x.com/kex2XfgqnI","original":"https://t.co/kex2XfgqnI","replacement":"https://x.com/breakdown_art/status/2105192577850806751/video/1"},{"type":"media","indices":[280,303],"id":"2105192035091443712","display":"pic.x.com/kex2XfgqnI","original":"https://t.co/kex2XfgqnI","replacement":"https://x.com/breakdown_art/status/2105192577850806751/video/1"},{"type":"media","indices":[280,303],"id":"2105192144394964992","display":"pic.x.com/kex2XfgqnI","original":"https://t.co/kex2XfgqnI","replacement":"https://x.com/breakdown_art/status/2105192577850806751/video/1"}]},"author":{"screen_name":"breakdown_art","url":"https://x.com/breakdown_art","id":"2070073164445646848","followers":63,"following":22,"likes":8,"media_count":8,"statuses":32,"name":"Breakdown","de